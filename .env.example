# Copy this file to .env and fill in real values. .env is gitignored — never commit real keys.

# Groq (LLM generation, guardrail/grading judge calls) - https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter (optional -- a small chain of free models, tried after Groq
# and before Anthropic. See RAG_OPENROUTER_MODEL_NAMES below to change
# which free models are used) - https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# RAG_OPENROUTER_MODEL_NAMES=nvidia/nemotron-3-super-120b-a12b:free,liquid/lfm-2.5-2.6b:free

# Anthropic (optional fallback of last resort, after Groq and OpenRouter --
# this one is paid, not free. Every LLM call in this app routes through
# config.get_llm(), which falls back here automatically if this key is set,
# or just skips straight to Groq-only/OpenRouter-only if left blank) -
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional, only needed if you switch generation/embedding providers
OPENAI_API_KEY=
GOOGLE_API_KEY=

# LangSmith (tracing + evaluation dataset/experiment tracking) - https://smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=rag-learn
